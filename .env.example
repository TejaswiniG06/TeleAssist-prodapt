LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Use only a free-plan account. No billing upgrade or paid fallback is performed.
LLM_FREE_PLAN_CONFIRMED=false
LLM_MIN_INTERVAL_SECONDS=15

# Local mode permits anonymous agent access only. Required mode fails closed.
AUTH_MODE=local
TELEASSIST_AGENT_KEY=
# Public local-demo editor key; replace before any shared deployment.
TELEASSIST_EDITOR_KEY=editor

# Split-service deployment; start.py sets URLs and uses the application agent key by default.
# An explicitly supplied RETRIEVAL_API_KEY must be accepted by retrieval; never use Gemini's key.
RETRIEVAL_URL=http://127.0.0.1:8001
RETRIEVAL_API_KEY=

# Dashboard addresses are deployment settings, never customer input.
# Single process: both defaults point to localhost:8000.
# Split mode: API_URL=http://127.0.0.1:8002, EDITOR_URL=http://127.0.0.1:8001.
# Set these in the dashboard shell; it does not load the provider .env.
# TELEASSIST_API_URL=http://127.0.0.1:8000
# TELEASSIST_EDITOR_URL=http://127.0.0.1:8000

# Optional isolated persistence directory; default is this project's runtime folder.
# TELEASSIST_STATE_DIR=D:/path/to/isolated/runtime
